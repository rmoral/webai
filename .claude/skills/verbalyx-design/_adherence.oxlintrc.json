      {
        "selector": "JSXOpeningElement[name.name='UsageMeter'] > JSXAttribute[name.name='plan'] > Literal[value!=/^(?:free|pro|unlimited|trial)$/]",
        "message": "<UsageMeter> plan must be one of 'free' | 'pro' | 'unlimited' | 'trial'."
      }
